process {
    executor = 'local'

    withName: FASTQC {
        cpus = 2
        memory = '4 GB'
    }

    withName: MULTIQC {
        cpus = 1
        memory = '2 GB'
    }
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '/media/volume/ngs-data/containers'
}

workDir = '/media/volume/ngs-data/nextflow/work'

params {
    reads = '/media/volume/ngs-data/projects/fastq-test/raw/*_{1,2}.fastq.gz'
}
